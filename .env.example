# For local development, use the following settings:
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433

#For EC2 deployment, use the following settings:
# SQL_SERVER_HOST=YOUR_HOST_HERE
# SQL_SERVER_PORT=YOUR_PORT_HERE

# Database credentials
SQL_ADMIN_USER=YOUR_USERNAME_HERE
SQL_ADMIN_PASSWORD=YOUR_PASSWORD_HERE

# Database credentials for the Read-only agent
SQL_AGENT_USER=YOUR_READ_ONLY_USERNAME_HERE
SQL_AGENT_PASSWORD=YOUR_READ_ONLY_PASSWORD_HERE

# Core API Key
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# Settings
Embeddings_model=LOCAL # Options: LOCAL, OPENAI
Local_Embedding_Model=YOUR_LOCAL_EMBEDDING_MODEL_HERE

# LangGraph Orchestration Layer
Agent_llm=DEEPSEEK # Options: DEEPSEEK, OPENAI
