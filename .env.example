# For local development, use the following settings:
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433

#For EC2 deployment, use the following settings:
# SQL_SERVER_HOST=YOUR_HOST_HERE
# SQL_SERVER_PORT=YOUR_PORT_HERE

# Database credentials
SQL_ADMIN_USER=YOUR_USERNAME_HERE
SQL_ADMIN_PASSWORD=YOUR_PASSWORD_HERE

# Core API Key
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE